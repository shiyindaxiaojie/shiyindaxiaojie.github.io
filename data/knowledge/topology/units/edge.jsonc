// Unit: edge. Public edge delivery: DNS, CDN, acceleration, and media edge capabilities.
// rootNode is a legacy stage node consumed by src/views/knowledge/index.vue.
// Keep it until the Vue layout moves into topology/perspectives/*.jsonc.
{
  "id": "edge",
  "rootNode": "edge-network",
  "nodes": [
    {
      "id": "edge-network",
      "kind": "stage",
      "zone": "network",
      "children": [
        "dns",
        "cdn",
        "dynamic-acceleration",
        "load-balance",
        "vod"
      ],
      "titleKey": "topology.nodes.edge-network.title",
      "summaryKey": "topology.nodes.edge-network.summary"
    },
    {
      "id": "dns",
      "kind": "concept",
      "zone": "network",
      "defaultOption": "public-dns",
      "options": [
        {
          "id": "public-dns",
          "path": "data/knowledge/network/dns.md",
          "nameKey": "topology.options.dns.public-dns.name"
        },
        {
          "id": "route53",
          "name": "Route 53",
          "path": null
        },
        {
          "id": "bind9",
          "name": "BIND 9",
          "path": null
        }
      ],
      "titleKey": "topology.nodes.dns.title",
      "summaryKey": "topology.nodes.dns.summary"
    },
    {
      "id": "cdn",
      "kind": "concept",
      "zone": "network",
