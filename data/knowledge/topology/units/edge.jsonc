        {
          "id": "cloudflare",
          "name": "Cloudflare",
          "path": null
        },
        {
          "id": "akamai",
          "name": "Akamai",
          "path": null
        }
      ],
      "titleKey": "topology.nodes.cdn.title",
      "summaryKey": "topology.nodes.cdn.summary"
    },
    {
      "id": "dynamic-acceleration",
      "kind": "concept",
      "zone": "network",
      "defaultOption": "tencent-ecdn",
      "options": [
        {
          "id": "tencent-ecdn",
          "path": null,
          "nameKey": "topology.options.dynamic-acceleration.tencent-ecdn.name"
        },
        {
          "id": "aliyun-dcdn",
          "path": null,
          "nameKey": "topology.options.dynamic-acceleration.aliyun-dcdn.name"
        },
        {
          "id": "cloudfront-dynamic",
