        },
        {
          "id": "aliyun-cdn",
          "path": null,
          "nameKey": "topology.options.cdn.aliyun-cdn.name"
        },
        {
          "id": "amazon-cloudfront",
          "name": "Amazon CloudFront",
          "path": null
